# Base URL of the tRPC API. iOS simulator + web can reach localhost directly.
# Android emulator: use http://10.0.2.2:3001/trpc
# Physical device: use your machine's LAN IP, e.g. http://192.168.x.x:3001/trpc
EXPO_PUBLIC_API_URL=http://localhost:3001/trpc

# Dev auth token. The stub auth treats this value as the userId, so set it to a
# real userId from the seeded DB (see README / `pnpm db:seed`).
EXPO_PUBLIC_DEV_USER_ID=
